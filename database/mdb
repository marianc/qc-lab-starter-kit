#!/usr/bin/env bash
# ============================================================================
# Pure PostgreSQL Database Management Script for macOS and Linux (No Python Required)
# ============================================================================

DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-5432}"
DB_USER="${DB_USER:-postgres}"
export PGPASSWORD="${DB_PASS:-Pass@word1}"
TARGET_DB="${TARGET_DB:-quality_control}"
BACKUP_DIR="backups"

usage() {
    echo "Usage: ./mdb restore [backup_filename]"
    echo "       ./mdb backup"
    exit 1
}

cmd_restore() {
    local dump_file="$1"

    if [ -z "$dump_file" ]; then
        echo "[INFO] Finding the latest backup file in $BACKUP_DIR/..."
        dump_file=$(ls -t "$BACKUP_DIR"/qc_pg_dump_*.sql 2>/dev/null | head -n 1)
        if [ -z "$dump_file" ]; then
            echo "[ERROR] No backup files found in $BACKUP_DIR/ directory!"
            exit 1
        fi
    else
        dump_file="$BACKUP_DIR/$dump_file"
    fi

    if [ ! -f "$dump_file" ]; then
        echo "[ERROR] Backup file not found: $dump_file"
        exit 1
    fi

    echo "[INFO] Restoring database '$TARGET_DB' from '$dump_file'..."

    echo "[INFO] Terminating existing connections to '$TARGET_DB'..."
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d postgres -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '$TARGET_DB' AND pid <> pg_backend_pid();" >/dev/null 2>&1

    echo "[INFO] Dropping database '$TARGET_DB' if it exists..."
    dropdb -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" --if-exists "$TARGET_DB"

    echo "[INFO] Creating fresh database '$TARGET_DB'..."
    createdb -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" "$TARGET_DB"

    echo "[INFO] Applying SQL dump..."
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$TARGET_DB" -f "$dump_file"

    if [ $? -eq 0 ]; then
        echo "[SUCCESS] Database restored successfully from $dump_file!"
    else
        echo "[ERROR] Database restoration encountered an error."
        exit 1
    fi
}

cmd_backup() {
    local timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="$BACKUP_DIR/qc_pg_dump_$timestamp.sql"
    
    mkdir -p "$BACKUP_DIR"
    echo "[INFO] Creating backup to $backup_file..."
    pg_dump -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$TARGET_DB" -F p -b -v -f "$backup_file"
    
    if [ $? -eq 0 ]; then
        echo "[SUCCESS] Backup created successfully: $backup_file"
    else
        echo "[ERROR] Backup failed."
        exit 1
    fi
}

case "$1" in
    restore)
        cmd_restore "$2"
        ;;
    backup)
        cmd_backup
        ;;
    *)
        usage
        ;;
esac
